# Mode testing tanpa backend (untuk Vercel/CF Pages langsung jalan)
VITE_USE_MOCK=true

# Konfigurasi MQTT (dipakai saat VITE_USE_MOCK=false)
VITE_MQTT_URL=wss://broker.example.com:8084/mqtt
VITE_MQTT_USER=aiot_device
VITE_MQTT_PASS=aiot_secret

# REST API backend
VITE_API_URL=https://api.aiot.example.com
